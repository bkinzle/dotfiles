#!/usr/bin/env bash
set -euo pipefail

REPO="${1:-$PWD}"

# Hold idle-sleep and display-sleep assertions for as long as claude runs, so
# stepping away mid-task doesn't suspend the machine or blank the screen.
# Set AGENT2PANE_CAFFEINATE=0 to opt out.
CAFFEINATE=""
if [[ "${AGENT2PANE_CAFFEINATE:-1}" != "0" ]] && command -v caffeinate >/dev/null 2>&1; then
  CAFFEINATE="caffeinate -di "
fi

# Normalize: expand ~ then strip $HOME prefix so both forms produce the same suffix
EXPANDED="${REPO/#\~/$HOME}"
SUFFIX="${EXPANDED#$HOME/}"
SUFFIX="${SUFFIX//\//-}"
SESSION="agent2pane-${SUFFIX}"

# Attach if session already exists
if tmux has-session -t "$SESSION" 2>/dev/null; then
  exec tmux attach -t "$SESSION"
fi

# Create new detached session
tmux new-session -d -s "$SESSION"

# Split left/right
tmux split-window -h -t "$SESSION":0.0

# Resize left pane to 35%
tmux resize-pane -t "$SESSION":0.0 -x 35%

# Set pane titles
tmux select-pane -t "$SESSION":0.0 -T "lazygit"
tmux select-pane -t "$SESSION":0.1 -T "claude"

# Left: lazygit
tmux send-keys -t "$SESSION":0.0 "cd $EXPANDED && lazygit" C-m

# Right: claude
tmux send-keys -t "$SESSION":0.1 "cd $EXPANDED && ${CAFFEINATE}claude --model 'opus[1m]'" C-m

exec tmux attach -t "$SESSION"
